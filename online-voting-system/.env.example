# Copy to .env (git-ignored). Used by `mvn spring-boot:run` and docker-compose.
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# Only emails ending in this domain can sign in. To test with Gmail addresses use gmail.com.
COLLEGE_DOMAIN=yourcollege.edu
# Comma-separated. These people get the admin page. Must also end in COLLEGE_DOMAIN.
ADMIN_EMAILS=you@yourcollege.edu

DB_PASSWORD=choose-a-password
DB_ROOT_PASSWORD=choose-another-password

# ---- Real OTP emails (leave SMTP_HOST empty to just print codes in the console) ----
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters (no spaces) below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# Optional. Gmail requires this to equal SMTP_USER, which is the default.
# MAIL_FROM=yourname@gmail.com
