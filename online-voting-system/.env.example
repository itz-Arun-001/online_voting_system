# Copy this file to .env (git-ignored) and fill in the values.
# Used by `mvn spring-boot:run` and docker-compose.

JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# Global fallback domain: only emails ending in this domain can sign in.
# Per-election domains can be set from the admin panel and override this for that election.
COLLEGE_DOMAIN=yourcollege.edu

# Comma-separated. These people get the admin page. Must also end in COLLEGE_DOMAIN.
ADMIN_EMAILS=you@yourcollege.edu

DB_PASSWORD=choose-a-password
DB_ROOT_PASSWORD=choose-another-password

# ---- Real OTP emails --------------------------------------------------------
# To send real OTP codes by email, fill in the SMTP settings below.
# Leaving SMTP_HOST empty prints codes in the console only (good for local dev).
#
# Gmail setup (recommended for testing):
#   1. Enable 2-Step Verification on your Google account.
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create a new App Password (select "Mail" / "Other").
#   4. Paste the 16-character password (no spaces) as SMTP_PASSWORD below.
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Optional. Gmail requires MAIL_FROM to equal SMTP_USER (which is the default).
# MAIL_FROM=yourname@gmail.com
